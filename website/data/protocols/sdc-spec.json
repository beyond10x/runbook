  "description": "Get the epic's ESS specification to complete (docs/phases.md steps 8 and 9). The specification comes from one of three sources, recorded as evidence on it: authored from the requirements list, reused from another repository or a public place, or reconstructed from an RFC, an OpenAPI document or an observed system. All three converge on the same ESS gate. The specification is complete when the gate passes at its current revision: `ess specify validate --strict-requires`, `ess specify compile`, no `UNMAPPED:` marker, `ess verify conform synthesize` with 0 refusals. Every added change id must trace to a requirement, and a reviewer other than its author must approve it. No action is admissible before the roadmap is approved. The case ends passed, or abandoned on an explicit decision. Late findings (docs/trial-2.md, \"The late-finding loop\"): the trace check also reads the open findings and is not traced while one is open; amend.upstream resolves them by amending the questions and the requirements list upstream, and the specification is re-derived.",
  "evidence": [
    {
      "description": "`grep -rn 'UNMAPPED:' spec`; its result is none (grep exits 1) or present, the markers in the body",
      "name": "open_markers",
      "produced_by": [
        "spec.scan"
      ]
    },
    {
      "description": "a person's approval of a roadmap revision; its result is approved",
      "name": "roadmap_approval",
      "produced_by": [
        "roadmap.read"
      ]
    },
    {
      "description": "`ess verify diff` of the specification joined to the requirements list: every added change id cites a requirement; its result is traced, untraced or finding (an open finding)",
      "name": "scope_trace",
      "produced_by": [
        "spec.trace"
      ]
    },
    {
      "description": "the result of `ess specify compile --path spec`, compiled or refused",
      "name": "spec_compile",
      "produced_by": [
        "spec.compile"
      ]
    },
    {
      "description": "a review of the specification against the requirements; approved or rejected",
      "name": "spec_review",
      "produced_by": [
        "spec.review"
      ]
    },
    {
      "description": "where the current specification revision came from; its result is authored, reused or reconstructed, and its body names the origin (repository, URL, RFC, OpenAPI document or system)",
      "name": "spec_source",
      "produced_by": [
        "spec.author",
        "spec.reconstruct",
        "spec.reuse"
      ]
    },
    {
      "description": "`ess verify conform synthesize --path spec --suite-format 5`; its result is clean (0 refusals) or refused",
      "name": "spec_synthesis",
      "produced_by": [
        "spec.synthesize"
      ]
    },
    {
      "description": "`ess specify validate --path spec --strict-requires`; its result is valid or invalid",
      "name": "spec_validation",
      "produced_by": [
        "spec.validate"
      ]
    }
  ],
