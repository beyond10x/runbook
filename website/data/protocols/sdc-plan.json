  "description": "Decompose the epic's complete ESS specification into AEP stories under the epic. The plan is the AEP planning store's epic and its stories; every result is a program's: `aep plan artifact validate`, the decomposition coverage check (every command of the compiled specification claimed by exactly one story, every synthesized scenario named by one), `aep plan artifact waves --kind story` and the AEP status of the epic and its stories. No plan evidence comes from an LLM. No action is admissible before the roadmap is approved or while the ESS gate does not pass on the current specification revision. A revised specification invalidates the validation and coverage records observed against the earlier revision. The case ends passed. Late findings (docs/trial-2.md, \"The late-finding loop\"): the coverage check also reads the open findings and is not covered while one is open; amend.upstream resolves them by amending the questions and the requirements list upstream, and the plan is re-derived.",
  "evidence": [
    {
      "description": "every command of the compiled specification claimed by exactly one story and every synthesized scenario named by at least one; its result is covered, uncovered or finding (an open finding)",
      "name": "decomposition_coverage",
      "produced_by": [
        "plan.cover"
      ]
    },
    {
      "description": "the ESS gate over a specification revision, the four checks run as one program; passed or failed",
      "name": "ess_gate",
      "produced_by": [
        "spec.gate"
      ]
    },
    {
      "description": "the result of `aep plan artifact validate`, valid or invalid",
      "name": "plan_validation",
      "produced_by": [
        "plan.validate"
      ]
    },
    {
      "description": "a person's approval of a roadmap revision; its result is approved",
      "name": "roadmap_approval",
      "produced_by": [
        "roadmap.read"
      ]
    },
    {
      "description": "`aep plan artifact waves --kind story`; its result is scoped (0 unassessed) or unassessed",
      "name": "stories_scoped",
      "produced_by": [
        "plan.scope"
      ]
    },
    {
      "description": "the AEP status of the epic and each of its stories, read by `aep plan artifact list`; its result is active when every one is active, otherwise the least advanced status (draft, proposed, rejected)",
      "name": "story_states",
      "produced_by": [
        "plan.status"
      ]
    }
  ],
