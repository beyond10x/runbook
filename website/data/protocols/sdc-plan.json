    {
      "arguments": [],
      "capabilities": [],
      "description": "resolve the open findings while the coverage check is not covered: a finding that changes no scope takes its default decision (an agent, recorded as an assumption with its reason), a scope-changing one waits for a person's decision; the decision amends the questions and the requirements list, and the plan is marked as derived from an earlier requirements revision (a new revision), so Canon sets aside every record about the old one and the writer re-derives it",
      "effect": "write",
      "executor": {
        "handoff": true,
        "kind": "program",
        "max_runs": 12,
        "program": "sdc-tool.sh amend plan",
        "timeout_s": 300
      },
      "name": "amend.upstream",
      "precondition": [
        {
          "depth": 0,
          "reference": "claim:plan.covers_spec",
          "text": "claim is false:"
        }
      ],
      "produces": [],
      "step": 0,
      "waits_for": []
    },
