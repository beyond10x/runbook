          "depth": 2,
          "reference": "claim:questions.shaped",
          "text": "claim is unknown:"
        },
        {
          "depth": 1,
          "text": "any of"
        },
        {
          "depth": 2,
          "reference": "claim:questions.settled",
          "text": "claim is false:"
        },
        {
          "depth": 2,
          "reference": "claim:questions.settled",
          "text": "claim is unknown:"
        }
      ],
      "produces": [],
      "step": 1,
      "waits_for": [
        "dissection.check",
        "questions.check"
      ]
