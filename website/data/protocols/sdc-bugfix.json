  "description": "Fix one reported bug in an existing code tree, red first: the bug report is dissected into a checked data document, a test that reproduces the bug is written and observed failing on the unchanged code while the rest of the suite passes, and only then is the fix admissible; the same test and the whole suite must pass on the fixed revision, the bug's story is moved to implemented, and the code tree's gate (build, test, lint, format) passes. Hand-back, the outcome fixed, also needs the description of the code merge request to reference a spec, as a check program says: a refused reference sends the description writer back and never reaches fixed. One case, no child cases; its inputs are the bug report and the code tree in the case's work directory, so a parent can open it as a child. No approval in this revision: a merge approval is the next addition.",
  "evidence": [
    {
      "description": "the record that the description writer ran and left the description at a new revision",
      "name": "description_written",
      "produced_by": [
        "handback.describe"
      ]
    },
    {
      "description": "a program's check of the dissection against its schema and the code tree; valid or invalid",
      "name": "dissection_check",
      "produced_by": [
        "dissection.check"
      ]
    },
    {
      "description": "the record that the dissection writer ran and left the dissection document at a new revision",
      "name": "dissection_written",
      "produced_by": [
        "bug.dissect"
      ]
    },
    {
      "description": "the code tree's gate run by a program: build, test, lint with warnings as errors, format check; passed or failed",
      "name": "gate_run",
      "produced_by": [
        "gate.run"
      ]
    },
    {
      "description": "the record that the fix moved the code tree to a new revision",
      "name": "implementation_change",
      "produced_by": [
        "change.fix"
      ]
    },
    {
      "description": "a program runs the reproducing test on the code tree with the code otherwise unchanged; red when the test compiles and fails and every other test passes, not_red otherwise (it passes, it does not compile, another test fails, or the code was changed)",
      "name": "repro_run",
      "produced_by": [
        "repro.run"
      ]
    },
    {
      "description": "the record that the test writer ran and left the repro record at a new revision",
      "name": "repro_written",
      "produced_by": [
        "test.reproduce"
      ]
    },
    {
      "description": "a check program reads the description and the change kind (defect or change); ok when the description references a spec as the check's rule asks, refused otherwise; its text is the check's one line",
      "name": "spec_reference",
      "produced_by": [
        "handback.spec-check"
      ]
    },
    {
      "description": "the record that the bug's story was moved to implemented in the planning store",
      "name": "story_record",
      "produced_by": [
        "story.update"
      ]
    },
    {
      "description": "a program runs the whole suite on a code revision; passed when the reproducing test is unchanged, reported ok under its test id, and nothing fails or is ignored",
      "name": "test_run",
      "produced_by": [
        "tests.run"
      ]
    }
  ],
