{
  "actions": [
    {
      "arguments": [],
      "capabilities": [],
      "description": "dissect the bug report into the dissection document; while no valid dissection is recorded",
      "effect": "write",
      "executor": {
        "default_model": "claude-haiku-5-5",
        "kind": "model",
        "max_runs": 3,
        "node_class": "other",
        "producer": "llm-node",
        "program": "sdc-node bug.dissect",
        "results": {
          "0": null
        },
        "retry_when": [
          "dissection_check"
        ],
        "timeout_s": 600
      },
      "name": "bug.dissect",
      "precondition": [
        {
          "depth": 0,
          "text": "any of"
        },
        {
          "depth": 1,
          "reference": "claim:dissection.valid",
          "text": "claim is false:"
        },
        {
          "depth": 1,
          "reference": "claim:dissection.valid",
          "text": "claim is unknown:"
        }
      ],
      "produces": [
        "dissection_written"
      ],
      "step": 0,
      "waits_for": []
    },
    {
      "arguments": [],
      "capabilities": [],
      "description": "check the current dissection; once per dissection revision, and only once the writer has left one (a check of a dissection that does not exist yet would end the case not_reproduced)",
      "effect": "read",
      "executor": {
        "kind": "program",
        "producer": "sdc-bugfix",
        "program": "sdc-tool.sh bugfix dissection-check",
        "results": {
          "*": "invalid",
          "0": "valid",
          "timeout": "invalid"
        }
      },
      "name": "dissection.check",
      "precondition": [
        {
          "depth": 0,
          "text": "all of"
        },
        {
          "depth": 1,
          "reference": "claim:dissection.written",
          "text": "claim"
        },
        {
          "depth": 1,
          "reference": "claim:dissection.checked",
          "text": "claim is unknown:"
        }
      ],
      "produces": [
        "dissection_check"
      ],
      "step": 1,
      "waits_for": [
        "bug.dissect"
      ]
    },
    {
      "arguments": [],
      "capabilities": [],
      "description": "write one test that reproduces the bug, into the code tree and the repro record, without changing any other file; once the dissection is valid and while no red is recorded",
      "effect": "write",
      "executor": {
        "default_model": "claude-haiku-5-5",
        "kind": "model",
        "max_runs": 3,
        "node_class": "implement",
        "producer": "llm-node",
        "program": "sdc-node test.reproduce",
        "results": {
          "0": null
        },
        "retry_when": [
          "repro_run"
