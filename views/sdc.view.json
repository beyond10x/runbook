{
  "format": "runbook.view/1",
  "runbook": "sdc",
  "protocols": [
    "^sdc(\\.|$)"
  ],
  "good_outcomes": [
    "operating",
    "delivered"
  ],
  "phases": {
    "stages": [
      "Intake",
      "Direction",
      "Specify & plan",
      "Build",
      "Ship"
    ],
    "items": [
      {
        "id": "input",
        "stage": "Intake",
        "label": "Input",
        "protocol": "sdc.intake",
        "claims": [
          "idea.shaped"
        ],
        "doc": "docs/phases.md step 1"
      },
      {
        "id": "dissection",
        "stage": "Intake",
        "label": "Dissection",
        "protocol": "sdc.intake",
        "claims": [
          "dissection.valid"
        ],
        "doc": "docs/phases.md step 2"
      },
      {
        "id": "interview",
        "stage": "Intake",
        "label": "Interview",
        "protocol": "sdc.intake",
        "claims": [
          "questions.shaped",
          "questions.settled"
        ],
        "doc": "docs/phases.md step 3"
      },
      {
        "id": "requirements",
        "stage": "Intake",
        "label": "Requirements",
        "protocol": "sdc.intake",
        "claims": [
          "requirements.valid"
        ],
        "doc": "docs/phases.md step 3"
      },
      {
        "id": "context",
        "stage": "Direction",
        "label": "Context defaults",
        "short": "Context",
        "protocol": "sdc.direction",
        "claims": [
          "context.valid",
          "context.approved"
        ],
        "doc": "docs/phases.md step 4"
      },
      {
        "id": "vision",
        "stage": "Direction",
        "label": "Vision",
        "protocol": "sdc.direction",
        "claims": [
          "vision.approved"
        ],
        "doc": "docs/phases.md step 5"
      },
      {
        "id": "roadmap",
        "stage": "Direction",
        "label": "Roadmap",
        "protocol": "sdc.direction",
        "claims": [
          "roadmap.valid",
          "roadmap.approved"
        ],
        "doc": "docs/phases.md step 6"
      },
      {
        "id": "epics",
        "stage": "Specify & plan",
        "label": "Epics",
        "protocol": "sdc",
        "claims": [
          "epics.opened"
        ],
        "doc": "docs/phases.md step 7"
      },
      {
        "id": "spec",
        "stage": "Specify & plan",
        "label": "Spec",
        "protocol": "sdc.spec",
        "claims": [
          "spec.sourced"
        ],
        "doc": "docs/phases.md step 8",
        "has_source": true
      },
      {
        "id": "gate",
        "stage": "Specify & plan",
        "label": "ESS gate",
        "protocol": "sdc.spec",
        "claims": [
          "spec.complete"
        ],
        "doc": "docs/phases.md step 9"
      },
      {
        "id": "specdone",
        "stage": "Specify & plan",
        "label": "Spec review",
        "short": "Spec review",
        "protocol": "sdc.spec",
        "claims": [
          "spec.traced",
          "spec.approved"
        ],
        "doc": "docs/phases.md step 9"
      },
      {
        "id": "plan",
        "stage": "Specify & plan",
        "label": "Plan",
        "protocol": "sdc.plan",
        "claims": [
          "plan.valid",
          "plan.covers_spec",
          "plan.scoped",
          "plan.active"
        ],
        "doc": "docs/phases.md step 10"
      },
      {
        "id": "stories",
        "stage": "Specify & plan",
        "label": "Stories",
        "protocol": "sdc.epic",
        "claims": [
          "stories.opened"
        ],
        "doc": "docs/phases.md step 10"
      },
      {
        "id": "implement",
        "stage": "Build",
        "label": "Implement",
        "protocol": "sdc.story",
        "claims": [
          "change.built"
        ],
        "doc": "docs/phases.md step 10"
      },
      {
        "id": "review",
        "stage": "Build",
        "label": "Review",
        "protocol": "sdc.story",
        "claims": [
          "change.reviewed"
        ],
        "doc": "docs/phases.md step 10"
      },
      {
        "id": "test",
        "stage": "Build",
        "label": "Test (ESS conformance)",
        "short": "Test",
        "protocol": "sdc.story",
        "claims": [
          "tests.pass"
        ],
        "doc": "docs/phases.md step 10"
      },
      {
        "id": "merge",
        "stage": "Build",
        "label": "Merge",
        "protocol": "sdc.story",
        "claims": [
          "change.merged"
        ],
        "doc": "docs/phases.md step 10"
      },
      {
        "id": "release",
        "stage": "Ship",
        "label": "Release",
        "protocol": "sdc.release",
        "claims": [
          "release.built",
          "release.accepted",
          "release.published"
        ],
        "doc": "docs/phases.md step 10"
      },
      {
        "id": "operate",
        "stage": "Ship",
        "label": "Operate",
        "protocol": "sdc.release",
        "claims": [
          "release.healthy"
        ],
        "doc": "docs/phases.md step 10",
        "root_outcome": "operating"
      }
    ],
    "absent": [
      {
        "stage": "Ticket",
        "steps": [
          "fetch",
          "research",
          "breakdown"
        ],
        "protocol_pattern": "ticket",
        "note": "A ticket run (\"SDC, implement this ticket\") would show fetch, research, breakdown here. This store holds no ticket protocol case."
      }
    ]
  },
  "file_kinds": {
    "rules": [
      {
        "match": "(^|/)(aep|\\.engineering/planning)/visions?/[^/]+\\.md$",
        "class": "direction",
        "kind": "vision"
      },
      {
        "match": "(^|/)(aep|\\.engineering/planning)/initiatives?/[^/]+\\.md$",
        "class": "direction",
        "kind": "roadmap"
      },
      {
        "match": "(^|/)(aep|\\.engineering/planning)/.+\\.md$",
        "class": "planning",
        "kind": "aep"
      },
      {
        "match": "(^|/)(adrs?|decisions)/[^/]+\\.md$",
        "flags": "i",
        "class": "decision",
        "kind": "adr"
      },
      {
        "match": "(^|/)adr[-_ ]?\\d+[^/]*\\.md$",
        "flags": "i",
        "class": "decision",
        "kind": "adr"
      },
      {
        "match": "(^|/)(idea|dissection|questions|requirements|context|findings|vision|roadmap)\\.(ya?ml|md)$",
        "class": "direction",
        "kind": "$basename"
      },
      {
        "match": "(^|/)scenarios/.*\\.ya?ml$",
        "class": "spec",
        "kind": "scenario"
      },
      {
        "match": "(^|/)domains/.*\\.ya?ml$",
        "class": "spec",
        "kind": "domain"
      },
      {
        "match": "(^|/)spec/.*\\.ya?ml$",
        "class": "spec",
        "kind": "$basename"
      },
      {
        "match": "(^|/)(system|components|topology)\\.ya?ml$",
        "class": "spec",
        "kind": "$basename"
      }
    ],
    "artifacts": {
      "idea": "direction",
      "dissection": "direction",
      "questions": "direction",
      "requirements": "direction",
      "context": "direction",
      "vision": "direction",
      "roadmap": "direction",
      "spec": "spec",
      "plan": "planning",
      "epic": "planning",
      "story": "planning",
      "stories": "planning",
      "change": "code",
      "release": "code"
    },
    "parsers": {
      "requirements": {
        "type": "keyed-list",
        "subject": "requirements",
        "list": "requirements",
        "word": "requirement",
        "added": [
          {
            "text": "requirement {id} added: {text!90}"
          }
        ],
        "changed": {
          "rules": [
            {
              "when": {
                "changed": [
                  "text"
                ]
              },
              "text": "requirement {id} reworded: {text!80}"
            },
            {
              "each": true,
              "except": [
                "text"
              ],
              "text": "requirement {id}: {$field} changed"
            }
          ]
        }
      },
      "questions": {
        "type": "keyed-list",
        "subject": "questions",
        "list": "questions",
        "word": "question",
        "added": [
          {
            "when": {
              "set": [
                "answer"
              ]
            },
            "text": "question {id} answered: {answer!60}[ (by {answered_by})]"
          },
          {
            "text": "question {id} asked: {question!90}"
          }
        ],
        "changed": {
          "rules": [
            {
              "when": {
                "was_unset": [
                  "answer"
                ],
                "set": [
                  "answer"
                ]
              },
              "stop": true,
              "text": "question {id} answered: {answer!70}[ (by {answered_by})]"
            },
            {
              "when": {
                "changed": [
                  "answer"
                ]
              },
              "text": "question {id}: answer changed to {answer!60}"
            },
            {
              "when": {
                "changed": [
                  "status"
                ]
              },
              "text": "question {id}: {old.status|'—'} → {status|'—'}",
              "variants": [
                {
                  "when": {
                    "equals": {
                      "status": "accepted"
                    },
                    "set": [
                      "answer"
                    ]
                  },
                  "text": "question {id}: {old.status|'—'} → {status|'—'} ({answer!50})"
                }
              ]
            },
            {
              "when": {
                "changed": [
                  "question"
                ]
              },
              "text": "question {id} reworded"
            }
          ],
          "otherwise": "question {id} changed"
        }
      },
      "findings": {
        "type": "keyed-list",
        "subject": "findings",
        "list": "findings",
        "word": "finding",
        "added": [
          {
            "text": "finding {id} raised[ by {raised_by}]: {text|summary|finding!70}"
          }
        ],
        "changed": {
          "rules": [
            {
              "when": {
                "changed": [
                  "status"
                ]
              },
              "stop": true,
              "text": "finding {id}: {old.status|'—'} → {status|'—'}[ (by {decided_by})]"
            }
          ],
          "otherwise": "finding {id} changed"
        }
      },
      "dissection": {
        "type": "keyed-list",
        "subject": "dissection",
        "list": "items",
        "word": "item",
        "added": [
          {
            "text": "dissection {id} ({type|'item'}): {note|span!70}"
          }
        ],
        "changed": {
          "otherwise": "dissection {id} changed"
        }
      },
      "context": {
        "type": "keyed-list",
        "subject": "context",
        "as": "map",
        "word": "context",
        "added": [
          {
            "text": "context {id} set: {value!60}[ ({status})]"
          }
        ],
        "removed": "context {id} removed",
        "changed": {
          "rules": [
            {
              "when": {
                "changed": [
                  "value"
                ]
              },
              "stop": true,
              "text": "context {id}: {old.value!36} → {value!36}[ ({status})]"
            },
            {
              "when": {
                "changed": [
                  "status"
                ]
              },
              "stop": true,
              "text": "context {id}: {old.status|'—'} → {status|'—'}"
            }
          ],
          "otherwise": "context {id}: reason changed"
        }
      },
      "roadmap": {
        "type": "document",
        "subject": "roadmap",
        "entries": {
          "word": "epic",
          "sections": "^[\\w.-]+\\s*:",
          "summary": "epics?:\\s*(.*)$"
        },
        "created": "roadmap written: epics {entries|'—'}"
      },
      "vision": {
        "type": "document",
        "subject": "vision"
      }
    }
  },
  "decisions": {
    "scope_answer": {
      "action": "scope.answer",
      "artifact": "questions",
      "list": "questions",
      "flag": "scope_changing"
    },
    "stall": {
      "action": "amend.upstream",
      "artifact": "findings",
      "list": "findings",
      "noun": "finding",
      "status": "status",
      "needs_person": "needs_person"
    }
  }
}
