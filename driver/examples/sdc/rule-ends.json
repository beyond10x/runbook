{
  "format": "sdc.rule-ends/1",
  "driver": {
    "capped_effects": ["write"],
    "cap_per_kind": true,
    "backstop": 8,
    "rejection_is_arrival": true,
    "own_failure_fed_back": true,
    "rejection_logs_fed_back": true
  },
  "rework_limit": 2,
  "questions": {
    "reject": "refused by the decider's check, asked again, then the default"
  },
  "findings": {
    "reject": "refused by the decider's check, asked again, then the default",
    "refused_by_check": null
  },
  "close": {},
  "approvals": {
    "sdc.direction/context.approve": {
      "by_rule": {"rule": "program-checks", "guards": [{"claim": "context.valid", "check": "context.check"}]}
    },
    "sdc.direction/roadmap.approve": {
      "by_rule": {"rule": "program-checks", "guards": [{"claim": "roadmap.valid", "check": "roadmap.validate"}]}
    },
    "sdc.release/release.publish": {
      "reject": {"decision": "explicitly_withheld", "outcome": "withheld"},
      "by_rule": {"rule": "program-checks", "guards": [
        {"claim": "gate.passed", "check": "spec.gate"},
        {"claim": "release.built", "check": "release.build"},
        {"claim": "release.accepted", "check": "acceptance.run"}
      ]}
    }
  },
  "checks": []
}
