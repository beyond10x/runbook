{
  "$artifacts": {
    "spec": "spec",
    "release": "release"
  },
  "spec.gate": {
    "argv": [
      "{dir}/tools/sdc-tool.sh",
      "ess-gate"
    ],
    "produces": "ess_gate",
    "subject": "spec",
    "producer": "ess",
    "results": {
      "0": "passed",
      "*": "failed"
    }
  },
  "delivery.read": {
    "copy": {
      "kind": "release_conformance",
      "from": "sdc.delivery"
    }
  },
  "release.publish": {
    "argv": [
      "{dir}/tools/sdc-tool.sh",
      "publish"
    ],
    "produces": "release_record",
    "subject": "release",
    "producer": "sdc-drive.deploy",
    "results": {
      "0": null
    }
  },
  "release.observe": {
    "argv": [
      "{dir}/tools/sdc-tool.sh",
      "observe"
    ],
    "produces": "health_observation",
    "subject": "release",
    "producer": "sdc-drive.monitor",
    "results": {
      "0": "healthy",
      "*": "unhealthy"
    }
  }
}
