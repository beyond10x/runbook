{
  "$artifacts": {
    "spec": "spec",
    "change": "impl",
    "findings": "findings.yaml",
    "requirements": "requirements.yaml"
  },
  "$independence": {
    "llm-review": [
      "different_principal"
    ]
  },
  "spec.gate": {
    "argv": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "ess-gate"
    ],
    "produces": "ess_gate",
    "subject": "spec",
    "producer": "ess",
    "results": {
      "0": "passed",
      "*": "failed"
    }
  },
  "change.implement": {
    "argv": [
      "sdc-node",
      "change.implement"
    ],
    "produces": "implementation_change",
    "subject": "change",
    "upstream": [
      "spec"
    ],
    "producer": "llm-node",
    "results": {
      "0": null
    },
    "llm": {
      "model": "claude-haiku-5-5",
      "max_turns": 40,
      "max_budget_usd": 2, "instructions": {"task": "instructions/change.implement.md", "coverage": "instructions/change.implement.coverage.md", "coverage_inputs": "instructions/change.implement.coverage.inputs.md"},
      "stub": [
        "stub-tree",
        "impl",
        "impl"
      ]
    },
    "retry_when": {
      "implementation_change": [
        "coverage_refused"
      ],
      "conformance_run": [
        "failed"
      ],
      "code_review": [
        "rejected"
      ],
      "merge_approval": [
        "rejected"
      ]
    },
    "max_runs": 3,
    "timeout_s": 1500,
    "postcondition": {
      "argv": [
        "{dir}/../../target/debug/sdc-reply",
        "check-coverage",
        "--tree",
        "impl"
      ],
      "kind": "requirement_coverage",
      "timeout_s": 120,
      "switch": "SDC_IMPLEMENT_COVERAGE"
    }
  },
  "tests.run": {
    "argv": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "story-tests",
      "impl",
      "--pool-wait",
      "1200"
    ],
    "timeout_s": 3000,
    "produces": "conformance_run",
    "subject": "change",
    "upstream": [
      "spec"
    ],
    "producer": "ess",
    "results": {
      "0": "passed",
      "5": "finding",
      "*": "failed"
    }
  },
  "change.review": {
    "argv": [
      "sdc-node",
      "change.review"
    ],
    "produces": "code_review",
    "subject": "change",
    "producer": "llm-review",
    "results": {
      "0": "approved",
      "1": "rejected"
    },
    "llm": {
      "model": "claude-haiku-5-5",
      "max_turns": 30,
      "max_budget_usd": 1, "instructions": {"task": "instructions/change.review.md", "inputs": "instructions/change.review.inputs.md", "coverage_inputs": "instructions/change.review.coverage.inputs.md", "coverage_note": "instructions/change.review.coverage-note.md", "facts": "instructions/change.review.facts.md", "facts_inputs": "instructions/change.review.facts.inputs.md"},
      "operations": [
        "dir.list",
        "file.read",
        "search"
      ],
      "stub": [
        "review-change"
      ]
    },
    "max_runs": 3,
    "timeout_s": 900
  },
  "merge.approve": {
    "manual": true,
    "argv": [
      "true"
    ],
    "produces": "merge_approval",
    "subject": "change",
    "producer": "{principal}",
    "results": {
      "0": "approved",
      "6": "rejected"
    }
  },
  "change.merge": {
    "argv": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "merge"
    ],
    "produces": "merge_record",
    "subject": "change",
    "producer": "runbook.merge",
    "results": {
      "0": null
    }
  },
  "amend.upstream": {
    "argv": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "amend",
      "story"
    ],
    "max_runs": 12,
    "timeout_s": 300,
    "handoff": "decide the open findings: in {work}/findings.yaml, for every finding with status needs_person, set `decision:` to one of its options or your own answer and `decided_by: person:<your id>` (the questions and the requirements are amended from it), or set `status: dismissed` when it is no conflict; then run again",
    "handoff_when": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "findings-wait"
    ]
  }
}
