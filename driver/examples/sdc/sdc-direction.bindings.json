{
  "$artifacts": {
    "requirements": "requirements.yaml",
    "goals": "goals.yaml",
    "context": "context.yaml",
    "vision": "aep/vision/product.md",
    "roadmap": "aep/initiative/roadmap.md",
    "findings": "findings.yaml",
    "questions": "questions.yaml"
  },
  "context.default": {
    "argv": [
      "sdc-node",
      "context.default"
    ],
    "llm": {
      "model": "claude-haiku-5-5",
      "max_turns": 15,
      "max_budget_usd": 0.5, "instructions": {"task": "instructions/context.default.md"},
      "stub": [
        "stub-file",
        "context.yaml",
        "context.yaml"
      ]
    },
    "retry_when": {
      "context_defaults": [
        "invalid"
      ],
      "context_approval": [
        "rejected"
      ]
    },
    "max_runs": 3,
    "timeout_s": 900
  },
  "context.check": {
    "argv": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "check-context"
    ],
    "produces": "context_defaults",
    "subject": "context",
    "upstream": [
      "requirements"
    ],
    "producer": "sdc-check",
    "results": {
      "0": "valid",
      "5": "finding",
      "timeout": "invalid",
      "*": "invalid"
    }
  },
  "context.approve": {
    "manual": true,
    "argv": [
      "true"
    ],
    "produces": "context_approval",
    "subject": "context",
    "producer": "{principal}",
    "results": {
      "0": "approved",
      "6": "rejected"
    }
  },
  "vision.write": {
    "argv": [
      "sdc-node",
      "vision.write"
    ],
    "llm": {
      "model": "claude-haiku-5-5",
      "max_turns": 15,
      "max_budget_usd": 0.5, "instructions": {"task": "instructions/vision.write.md"},
      "stub": [
        "stub-vision"
      ]
    },
    "max_runs": 3,
    "timeout_s": 900,
    "retry_when": {
      "vision_approval": [
        "rejected"
      ]
    }
  },
  "vision.approve": {
    "manual": true,
    "argv": [
      "true"
    ],
    "produces": "vision_approval",
    "subject": "vision",
    "producer": "{principal}",
    "results": {
      "0": "approved",
      "6": "rejected"
    }
  },
  "roadmap.write": {
    "argv": [
      "sdc-node",
      "roadmap.write"
    ],
    "llm": {
      "model": "claude-haiku-5-5",
      "max_turns": 15,
      "max_budget_usd": 0.5, "instructions": {"task": "instructions/roadmap.write.md"},
      "stub": [
        "stub-roadmap"
      ]
    },
    "retry_when": {
      "roadmap_validation": [
        "invalid"
      ],
      "roadmap_approval": [
        "rejected"
      ]
    },
    "max_runs": 3,
    "timeout_s": 900
  },
  "roadmap.validate": {
    "argv": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "roadmap-validate"
    ],
    "produces": "roadmap_validation",
    "subject": "roadmap",
    "producer": "aep",
    "results": {
      "0": "valid",
      "timeout": "invalid",
      "*": "invalid"
    }
  },
  "roadmap.approve": {
    "manual": true,
    "argv": [
      "true"
    ],
    "produces": "roadmap_approval",
    "subject": "roadmap",
    "upstream": [
      "vision"
    ],
    "producer": "{principal}",
    "results": {
      "0": "approved",
      "6": "rejected"
    }
  },
  "amend.upstream": {
    "argv": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "amend",
      "context"
    ],
    "retry_when": {
      "context_defaults": [
        "finding"
      ]
    },
    "max_runs": 12,
    "timeout_s": 300,
    "handoff": "decide the open findings: in {work}/findings.yaml, for every finding with status needs_person, set `decision:` to one of its options or your own answer and `decided_by: person:<your id>` (the questions and the requirements are amended from it), or set `status: dismissed` when it is no conflict; then run again",
    "handoff_when": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "findings-wait"
    ]
  }
}
