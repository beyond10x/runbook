{
  "$artifacts": {
    "report": "bug.yaml",
    "dissection": "bug-dissection.json",
    "repro": "repro",
    "change": "impl",
    "story": "aep",
    "description": "handback/mr-description.md"
  },
  "bug.dissect": {
    "argv": [
      "sdc-node",
      "bug.dissect"
    ],
    "llm": {
      "model": "claude-haiku-5-5",
      "max_turns": 20,
      "max_budget_usd": 1, "instructions": {"task": "instructions/bug.dissect.md"},
      "stub": [
        "stub-file",
        "bugfix-pager/stub-dissection.json",
        "bug-dissection.json"
      ]
    },
    "produces": "dissection_written",
    "subject": "dissection",
    "producer": "llm-node",
    "results": {
      "0": null
    },
    "retry_when": {
      "dissection_check": [
        "invalid"
      ]
    },
    "max_runs": 3,
    "timeout_s": 600
  },
  "dissection.check": {
    "argv": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "bugfix",
      "dissection-check"
    ],
    "produces": "dissection_check",
    "subject": "dissection",
    "producer": "sdc-bugfix",
    "results": {
      "0": "valid",
      "timeout": "invalid",
      "*": "invalid"
    }
  },
  "test.reproduce": {
    "argv": [
      "sdc-node",
      "test.reproduce"
    ],
    "llm": {
      "model": "claude-haiku-5-5",
      "max_turns": 30,
      "max_budget_usd": 1, "instructions": {"task": "instructions/test.reproduce.md"},
      "stub": [
        "stub-repro",
        "bugfix-pager/stub-repro"
      ]
    },
    "produces": "repro_written",
    "subject": "repro",
    "producer": "llm-node",
    "results": {
      "0": null
    },
    "retry_when": {
      "repro_run": [
        "not_red"
      ]
    },
    "max_runs": 3,
    "timeout_s": 900
  },
  "repro.run": {
    "argv": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "bugfix",
      "repro-run",
      "--pool-wait",
      "1200"
    ],
    "timeout_s": 3000,
    "produces": "repro_run",
    "subject": "repro",
    "upstream": [
      "change"
    ],
    "producer": "sdc-bugfix",
    "results": {
      "0": "red",
      "timeout": "not_red",
      "*": "not_red"
    }
  },
  "change.fix": {
    "argv": [
      "sdc-node",
      "change.fix"
    ],
    "produces": "implementation_change",
    "subject": "change",
    "upstream": [
      "repro"
    ],
    "producer": "llm-node",
    "results": {
      "0": null
    },
    "llm": {
      "model": "claude-haiku-5-5",
      "max_turns": 40,
      "max_budget_usd": 2, "instructions": {"task": "instructions/change.fix.md", "stdlib": "instructions/change.fix.stdlib.md", "no_gate": "instructions/change.fix.no-gate.md"},
      "stub": [
        "stub-tree",
        "bugfix-pager/stub-fix",
        "impl"
      ]
    },
    "retry_when": {
      "test_run": [
        "failed"
      ],
      "gate_run": [
        "failed"
      ]
    },
    "max_runs": 3,
    "timeout_s": 1500
  },
  "tests.run": {
    "argv": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "bugfix",
      "tests-run",
      "--pool-wait",
      "1200"
    ],
    "timeout_s": 3000,
    "produces": "test_run",
    "subject": "change",
    "upstream": [
      "repro"
    ],
    "producer": "sdc-bugfix",
    "results": {
      "0": "passed",
      "timeout": "failed",
      "*": "failed"
    }
  },
  "story.update": {
    "argv": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "bugfix",
      "story-update"
    ],
    "produces": "story_record",
    "subject": "story",
    "producer": "sdc-bugfix",
    "results": {
      "0": null
    },
    "max_runs": 2
  },
  "gate.run": {
    "argv": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "bugfix",
      "gate-run",
      "--pool-wait",
      "1200"
    ],
    "timeout_s": 4200,
    "produces": "gate_run",
    "subject": "change",
    "producer": "sdc-bugfix",
    "results": {
      "0": "passed",
      "timeout": "failed",
      "*": "failed"
    }
  },
  "handback.describe": {
    "argv": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "bugfix",
      "handback-describe"
    ],
    "produces": "description_written",
    "subject": "description",
    "producer": "sdc-bugfix",
    "results": {
      "0": null
    },
    "retry_when": {
      "spec_reference": [
        "refused"
      ]
    },
    "max_runs": 2
  },
  "handback.spec-check": {
    "argv": [
      "{dir}/../../../bindings/tools/sdc-tool.sh",
      "bugfix",
      "handback-check",
      "--",
      "sdc-bugfix",
      "spec-check",
      "--spec-dir",
      "spec"
    ],
    "produces": "spec_reference",
    "subject": "description",
    "producer": "spec-check",
    "results": {
      "0": "ok",
      "77": "refused"
    }
  }
}
