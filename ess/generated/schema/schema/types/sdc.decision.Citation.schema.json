{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdc.invalid/types/sdc.decision.Citation.schema.json",
  "$ref": "#/$defs/sdc.decision.Citation",
  "x-ess-provenance": {
    "system": "sdc",
    "specification_version": "v1",
    "contract_digest": "slice-sha256/2:228ae7b85320d84a7e056f954eaa303f8f52c9dbfc8b4a62bc48bcd24df1adf9",
    "regenerate": "ess generate"
  },
  "$defs": {
    "sdc.decision.ArtifactId": {
      "title": "ArtifactId",
      "description": "A case artifact id (canon-case/1 artifacts key), such as roadmap.",
      "x-ess-name": "sdc.decision.ArtifactId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "sdc.decision.ArtifactRevisionCitation": {
      "title": "ArtifactRevisionCitation",
      "x-ess-name": "sdc.decision.ArtifactRevisionCitation",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/sdc.decision.ArtifactId"
        },
        "revision": {
          "$ref": "#/$defs/sdc.decision.Revision"
        },
        "case": {
          "$ref": "#/$defs/sdc.decision.CaseId",
          "description": "The case whose snapshot holds the artifact; absent means the request's case."
        },
        "entry": {
          "description": "One entry of the artifact, for artifact goals: the entry id (product/p1). The ground rests on that entry: it must exist in the current goals layers, apply at the check's instant (inside its validity window, not overridden by a lower layer) and still have the digest. A revision that moved since is noted (revision_moved), not refused (docs/requester.md decision 3).",
          "type": "string"
        },
        "digest": {
          "description": "sha256:<hex> of the cited entry as sdc-goals digest prints it; written by the grounding check when absent, so a later check sees a change.",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "revision"
      ],
      "additionalProperties": false
    },
    "sdc.decision.CaseId": {
      "title": "CaseId",
      "description": "A Canon case id (canon-case/1 id), such as IDEA-1.direction.",
      "x-ess-name": "sdc.decision.CaseId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "sdc.decision.Citation": {
      "title": "Citation",
      "description": "Where a ground is: path:line, a record id, artifact@revision, or one entry of an artifact (goals@<revision>#<entry id>). A program checks that each resolves (tools/decision-grounds.sh; a goals entry through sdc-goals ground).",
      "x-ess-name": "sdc.decision.Citation",
      "x-ess-kind": "union",
      "oneOf": [
        {
          "title": "artifact_revision",
          "type": "object",
          "properties": {
            "form": {
              "type": "string",
              "const": "artifact_revision"
            },
            "value": {
              "$ref": "#/$defs/sdc.decision.ArtifactRevisionCitation"
            }
          },
          "required": [
            "form",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "title": "path_line",
          "type": "object",
          "properties": {
            "form": {
              "type": "string",
              "const": "path_line"
            },
            "value": {
              "$ref": "#/$defs/sdc.decision.PathLineCitation"
            }
          },
          "required": [
            "form",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "title": "record_id",
          "type": "object",
          "properties": {
            "form": {
              "type": "string",
              "const": "record_id"
            },
            "value": {
              "$ref": "#/$defs/sdc.decision.RecordCitation"
            }
          },
          "required": [
            "form",
            "value"
          ],
          "additionalProperties": false
        }
      ],
      "x-ess-union-tag": "form"
    },
    "sdc.decision.PathLineCitation": {
      "title": "PathLineCitation",
      "x-ess-name": "sdc.decision.PathLineCitation",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "path": {
          "description": "A file path relative to the repository root.",
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "line_end": {
          "type": "integer"
        },
        "digest": {
          "description": "sha256:<hex> of the cited lines when the ground was checked; a different digest later means the ground changed.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "additionalProperties": false
    },
    "sdc.decision.RecordCitation": {
      "title": "RecordCitation",
      "x-ess-name": "sdc.decision.RecordCitation",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "store": {
          "$ref": "#/$defs/sdc.decision.RecordStore"
        },
        "record_id": {
          "type": "string"
        }
      },
      "required": [
        "store",
        "record_id"
      ],
      "additionalProperties": false
    },
    "sdc.decision.RecordStore": {
      "title": "RecordStore",
      "description": "Where a cited record id is looked up: the decision request log, a case's evidence/ (canon-evidence/1 id), authority.json, decisions.json, or an AEP planning store (kind:name).",
      "x-ess-name": "sdc.decision.RecordStore",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "sdc_decisions",
        "canon_evidence",
        "canon_authority",
        "canon_decisions",
        "aep_artifact"
      ]
    },
    "sdc.decision.Revision": {
      "title": "Revision",
      "description": "An artifact or case revision as the case snapshot writes it.",
      "x-ess-name": "sdc.decision.Revision",
      "x-ess-kind": "newtype",
      "type": "string"
    }
  }
}
