    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "$ref": "#/$defs/sdc.daemon.Session.State"
    }
  },
  "required": [
    "session_id",
    "client",
    "opened_at",
    "state"
  ],
  "additionalProperties": false,
