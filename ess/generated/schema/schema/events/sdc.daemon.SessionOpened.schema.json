      "type": "string",
      "maxLength": 200,
      "x-ess-invariants": [
        "value.count <= 200"
      ]
    },
    "sdc.daemon.SessionId": {
      "title": "SessionId",
      "description": "The name of a session, chosen by the client that opens it.",
      "x-ess-name": "sdc.daemon.SessionId",
      "x-ess-kind": "newtype",
      "type": "string"
    }
  }
